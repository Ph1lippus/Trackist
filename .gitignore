# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
.aider*
.kilo/plans

# Android signing material and Firebase config.
# These are credentials: CI restores them from GitHub Secrets
# (ANDROID_KEYSTORE_BASE64 / GOOGLE_SERVICES_JSON_B64) and they must never be
# committed, or anyone with repository access can sign an "official" APK.
android/app/upload.keystore
android/app/google-services.json
*.keystore
*.jks
*.p12

# Supabase deployment-specific files
supabase/migrations/
supabase/config.toml

# Local setup scripts.
# Ad-hoc helpers live here and stay untracked, but the ones the CI workflow
# invokes are part of the build and must be committed:
#   mint-service-token.cjs, verify-assetlinks-fingerprint.cjs
scripts/*
!scripts/mint-service-token.cjs
!scripts/verify-assetlinks-fingerprint.cjs
